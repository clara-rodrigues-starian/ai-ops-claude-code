{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"c:\\Users\\ClaraCristineSouzaRo\\OneDrive - Starian\\AI OPS\\Claude code\\.claude\\git-sync.ps1\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Sincronizando com GitHub...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_tracker.py"
          }
        ]
      }
    ]
  }
}

